# Copy this file to .env, then set REPORTS_ROOT to the folder on THIS machine.
# Every user/server has a different path; do not hard-code it in Python.
REPORTS_ROOT=D:\\suprajit
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/qube_reports
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ChangeMe123!
SCAN_INTERVAL_SECONDS=30

# Admin console lock-down
# ------------------------
# Only requests from these IPs/CIDR ranges get ADMIN access, even if the
# logged-in account has role=ADMIN. Everyone else who signs in with that
# account still gets in, but only as an ordinary user (search/download),
# never the admin console. Comma-separate multiple entries.
# - Keep 127.0.0.1,::1 to restrict admin to THIS machine only.
# - If FastAPI runs on a cloud/VPN server and you reach it over a VPN,
#   add your VPN client IP too, e.g. 127.0.0.1,::1,10.8.0.2
ADMIN_ALLOWED_HOSTS=127.0.0.1,::1
# Set to true only if a reverse proxy in front of FastAPI adds a trustworthy
# X-Forwarded-For header with the real client IP. Leave false otherwise.
TRUST_PROXY_HEADERS=false
